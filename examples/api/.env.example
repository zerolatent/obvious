# Which login methods this server mounts. Comma-separated, any of
# email-password, google, apple, passkey. Unset defaults to email-password.
AUTH_PROVIDERS=email-password,passkey

# Postgres connection string used by @app/db.
DATABASE_URL=postgres://postgres:postgres@localhost:5432/obvious

# This server's own origin. Used to build OAuth redirect URLs; must match
# wherever you actually run it.
BETTER_AUTH_URL=http://localhost:4000

# Session/token signing secret. Generate one with `openssl rand -base64 32`.
BETTER_AUTH_SECRET=

# Port the bare node:http server listens on.
PORT=4000

# Better Auth's own env var (read automatically, no packages/auth wiring
# needed): origins besides BETTER_AUTH_URL allowed to make state-changing
# requests (sign-up, sign-in, sign-out). examples/web proxies its browser
# requests through its own Next.js server, but that server forwards the
# browser's original Origin header unchanged when it hops here, so this
# server still sees http://localhost:3001, not its own origin, and rejects
# it with INVALID_ORIGIN unless listed. Comma-separated for more than one.
BETTER_AUTH_TRUSTED_ORIGINS=http://localhost:3001

# Only needed if you also run examples/mobile against this server: the
# app.json `expo.scheme` the mobile OAuth deep-link returns through.
# MOBILE_APP_SCHEME=obvious-auth-example

# Only needed with AUTH_PROVIDERS=google — see the root README's provider guide.
# GOOGLE_CLIENT_ID=
# GOOGLE_CLIENT_SECRET=

# Only needed with AUTH_PROVIDERS=apple — see the root README's provider guide.
# APPLE_CLIENT_ID=
# APPLE_CLIENT_SECRET=
# APPLE_BUNDLE_ID=
