# Public origin of the auth server; used to build OAuth redirect URLs.
BETTER_AUTH_URL=http://localhost:3000

# Signing secret for sessions and tokens. Generate per environment.
BETTER_AUTH_SECRET=

# Auth provider enablement (comma-separated, validated at boot).
# Known ids: email-password, google, apple, passkey. Default: email-password.
AUTH_PROVIDERS=email-password

# Google OAuth (social sign-in) — required when "google" is in AUTH_PROVIDERS.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Apple Sign-In (social sign-in) — required when "apple" is in AUTH_PROVIDERS.
APPLE_CLIENT_ID=
APPLE_CLIENT_SECRET=
APPLE_BUNDLE_ID=

# Require a proven email address before a session is issued (default: false).
# When true, signup mails a verification link and an unverified account cannot
# log in. Turning this on locks out existing unverified users until they click
# the link. Accepts 1/true/yes/on and 0/false/no/off.
AUTH_REQUIRE_EMAIL_VERIFICATION=false

# Mail delivery: none is configured here on purpose. With no mailer passed to
# createAuth(), reset and verification messages are printed to the server log
# (dev only — see "Password reset & email verification" in the README).

# Scheme apps/mobile registers with the OS; trusted as an OAuth deep-link
# callback origin. Must match "expo.scheme" in apps/mobile/app.json.
MOBILE_APP_SCHEME=obvious-auth

# Postgres connection string used by packages/db.
DATABASE_URL=postgres://postgres:postgres@localhost:5432/obvious

# Structured logging verbosity for packages/auth's own instrumentation
# (provider boot errors, rate-limit hits, rejected OAuth callbacks, email
# dispatch). One of debug|info|warn|error. Default: warn (quiet in production
# until something actually fails).
AUTH_LOG_LEVEL=warn

# Rate limiting for auth endpoints (sign-in, sign-up, password reset).
# Enabled by default everywhere except NODE_ENV=test, so the test suite's
# repeated sign-in/sign-up calls don't trip 429s incidentally.
AUTH_RATE_LIMIT_ENABLED=true
# Global window (seconds) and max requests per window; sign-in/sign-up and
# password-reset endpoints apply stricter derived limits on top of these —
# see packages/auth/src/rate-limit.ts.
AUTH_RATE_LIMIT_WINDOW_SECONDS=60
AUTH_RATE_LIMIT_MAX=10
