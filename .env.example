# Auth provider enablement (comma-separated, validated at boot).
# Known ids: email-password, google, apple, passkey. Default: email-password.
AUTH_PROVIDERS=email-password

# Google OAuth (social sign-in) — required when "google" is in AUTH_PROVIDERS.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Apple Sign-In (social sign-in) — required when "apple" is in AUTH_PROVIDERS.
APPLE_CLIENT_ID=
APPLE_CLIENT_SECRET=
APPLE_BUNDLE_ID=

# Postgres connection string used by packages/db.
DATABASE_URL=postgres://postgres:postgres@localhost:5432/obvious
